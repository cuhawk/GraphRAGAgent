# NexusGraph configuration (copy to .env and adjust).
# Every value also works as a plain environment variable; nesting uses "__".

# ---- storage -----------------------------------------------------------
# local   : SQLite + local vector index + file-backed RDF (no services)
# postgres: PostgreSQL + pgvector + Redis
NEXUSGRAPH_PROFILE=local
NEXUSGRAPH_DATA_DIR=./data
# Optional explicit overrides (derived from the profile when unset):
# NEXUSGRAPH_DATABASE_URL=postgresql+psycopg://nexusgraph:nexusgraph@localhost:5432/nexusgraph
# NEXUSGRAPH_REDIS_URL=redis://localhost:6379/0
# NEXUSGRAPH_RDF_STORE_PATH=./data/rdf

# Seed + ingest the synthetic dataset automatically when stores are empty.
NEXUSGRAPH_BOOTSTRAP_ON_START=true

# ---- API ----------------------------------------------------------------
# When set, /v1/* requires the X-API-Key header. Unset = open API
# (documented limitation; use a real auth proxy for multi-tenant deployments).
# NEXUSGRAPH_API_KEY=change-me

# ---- LLM ----------------------------------------------------------------
# mock               : fully deterministic pipeline (no network; used by tests/evals)
# openai-compatible  : any OpenAI-compatible chat API (planner + synthesizer)
NEXUSGRAPH_LLM__PROVIDER=mock
# NEXUSGRAPH_LLM__BASE_URL=https://api.example.com/v1
# NEXUSGRAPH_LLM__API_KEY=sk-...
# NEXUSGRAPH_LLM__MODEL=your-model-name
# Embeddings: hash (deterministic, default) or openai-compatible
NEXUSGRAPH_LLM__EMBEDDING_PROVIDER=hash
# Rough cost accounting only (USD per 1M tokens) - set for your provider.
# NEXUSGRAPH_LLM__INPUT_PRICE_PER_MTOK=0.15
# NEXUSGRAPH_LLM__OUTPUT_PRICE_PER_MTOK=0.60

# ---- limits (guards / budgets; see docs/THREAT_MODEL.md) ----------------
# NEXUSGRAPH_LIMITS__MAX_TOOL_CALLS_PER_RUN=12
# NEXUSGRAPH_LIMITS__MAX_ROWS=500
# NEXUSGRAPH_LIMITS__MAX_RESULT_BYTES=64000
# NEXUSGRAPH_LIMITS__MAX_INPUT_CHARS=8000
# NEXUSGRAPH_LIMITS__RETRIEVAL_K=6

# ---- observability ------------------------------------------------------
NEXUSGRAPH_LOG_LEVEL=INFO
# NEXUSGRAPH_LOG_JSON=1
# Mirror spans to an OTLP collector (app-local traces always remain available):
# NEXUSGRAPH_OTLP_ENDPOINT=http://localhost:4318/v1/traces
